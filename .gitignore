# ============================================================
# Git Ignore Configuration for Reproducible Research Repository
# ============================================================

# Virtual Environments
.venv/
env/
venv/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# IDE & Editor Directories
.vscode/
.idea/
.devcontainer/

# Scratch & Temporary Analysis Files
scratch/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Training Artifacts
*.log
catboost_info/

# Streamlit Local Cache
.streamlit/*
!.streamlit/config.toml

# LaTeX Compilation Artifacts (keep main.tex, references.bib, and main.pdf)
main.aux
main.bbl
main.bcf
main.blg
main.log
main.run.xml
*.synctex.gz
*.out
*.toc
*.fls
*.fdb_latexmk

# Local Working Drafts (Office formats)
*.docx
*.pptx

# Legacy Model Binaries
models/*.joblib

# Internal Documentation & Audit Notes
docs/
